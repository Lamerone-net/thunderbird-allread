{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.3.1",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "allread@sparviero.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/allread.svg",
      "32": "icons/allread.svg",
      "64": "icons/allread.svg"
    }
  },
  "icons": {
    "16": "icons/allread.svg",
    "32": "icons/allread.svg",
    "64": "icons/allread.svg"
  }
}
